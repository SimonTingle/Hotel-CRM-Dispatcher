# 🔐 Local Development Environment
# Copy this to .env and run locally with TEST_MODE=true
# These are test values — safe to use on your machine

# WhatsApp / Meta Cloud API — Test values
WA_VERIFY_TOKEN=test_verify_token_local_dev_only
WA_PHONE_NUMBER_ID=12345
WA_ACCESS_TOKEN=test_access_token_local_dev_only
WA_APP_SECRET=test_app_secret_32chars_padding!!!

# AI Provider — Use test mode instead
GEMINI_API_KEY=test_gemini_key_local
OPENAI_API_KEY=test_openai_key_local
AI_PROVIDER=gemini

# Redis — Local instance
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_HOURS=24

# Supabase — Point to local instance or test project
SUPABASE_URL=https://test-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=test_supabase_service_role_key_local_only
DB_ENCRYPTION_KEY=test_key_32chars_exactly_padded

# Operations — Test values
OPS_WHATSAPP_GROUP_ID=test_group_id
ADMIN_API_KEY=test_admin_key_local_dev_only

# Feature flags — Enable test mode to skip real API calls
TEST_MODE=true
