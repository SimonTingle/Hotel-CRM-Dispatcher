# 🔐 SECURITY: Never commit real values. Use .env (gitignored) for production.
# Copy this file to .env and fill in real values from Meta/Supabase/Google.

# WhatsApp / Meta Cloud API — Get from https://developers.facebook.com
WA_VERIFY_TOKEN=your_random_token_here_min_32_chars
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WA_ACCESS_TOKEN=your_meta_access_token
WA_APP_SECRET=your_meta_app_secret

# AI Provider — Choose one, leave the other empty
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini

# Redis — Railway auto-injects this in production
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_HOURS=24

# Supabase — Get from https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DB_ENCRYPTION_KEY=your_32_char_encryption_key_padded

# Operations
OPS_WHATSAPP_GROUP_ID=your_whatsapp_group_id
ADMIN_API_KEY=your_secret_admin_api_key_min_32_chars

# Feature flags
TEST_MODE=false
